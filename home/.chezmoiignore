# Paths in $HOME that chezmoi must leave alone. Listing a path here also
# hides it from `chezmoi unmanaged`, so this doubles as the "not tracked on
# purpose" list.

**/.DS_Store

# Runtime state: only the one tracked file in each directory is managed.
.claude/*
!.claude/CLAUDE.md
.config/herdr/*
!.config/herdr/config.toml

# OpenCode installs its plugin dependencies and keeps its state here.
.config/opencode/bun.lock
.config/opencode/cli.json
.config/opencode/node_modules
.config/opencode/package-lock.json
.config/opencode/package.json
.config/opencode/service.json

.config/lazygit/state.yml
.config/oh-my-posh/*.omp.json.bak

# Other tools' config that is deliberately not tracked. chezmoi keeps its own
